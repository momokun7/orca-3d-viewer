{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "3d-viewer",
  "name": "3D Viewer",
  "version": "1.0.2",
  "execution": "sandboxed-ui",
  "description": "Preview 3D models in Orca's editor: GLB and glTF, STL, PLY, OBJ, FBX and USD. Orbit, zoom and pan, play animations, and check the model's real-world size on a floor grid. Read-only.",
  "license": "MIT",
  "repository": "https://github.com/momokun7/orca-3d-viewer",
  "icon": "assets/icon.png",
  "cover": {
    "path": "docs/images/plugin-page/cover.png",
    "alt": "The Stanford Bunny on a floor grid in 3D Viewer, with its vertex count and real-world size in the status bar"
  },
  "screenshots": [
    {
      "path": "docs/images/plugin-page/bunny.png",
      "alt": "The Stanford Bunny on a floor grid, with the status bar reading 156 × 154 × 121 mm and Grid 10 mm",
      "caption": "Real-world size on a floor grid"
    },
    {
      "path": "docs/images/plugin-page/chess.png",
      "alt": "A textured chess set on a marble board, opened from a GLB file",
      "caption": "Textures and materials from glTF"
    },
    {
      "path": "docs/images/plugin-page/fox.png",
      "alt": "A low-poly fox with its Survey animation chosen in the clip menu",
      "caption": "Animations with a clip menu"
    },
    {
      "path": "docs/images/plugin-page/dark.png",
      "alt": "A boombox opened from an FBX file, shown with the dark theme",
      "caption": "FBX, STL, PLY and OBJ too, in light or dark"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "glb",
        "title": "3D",
        "extensions": [
          ".glb"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "gltf",
        "title": "3D",
        "extensions": [
          ".gltf"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      },
      {
        "id": "stl",
        "title": "3D",
        "extensions": [
          ".stl"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "ply",
        "title": "3D",
        "extensions": [
          ".ply"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "obj",
        "title": "3D",
        "extensions": [
          ".obj"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      },
      {
        "id": "fbx",
        "title": "3D",
        "extensions": [
          ".fbx"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "usdz",
        "title": "3D",
        "extensions": [
          ".usdz"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "usda",
        "title": "3D",
        "extensions": [
          ".usda"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      },
      {
        "id": "usd",
        "title": "3D",
        "extensions": [
          ".usd"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "usdc",
        "title": "3D",
        "extensions": [
          ".usdc"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      }
    ]
  },
  "capabilities": []
}
