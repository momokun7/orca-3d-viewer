{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "3d-viewer",
  "name": "3D Viewer",
  "version": "1.0.0",
  "execution": "sandboxed-ui",
  "description": "Preview 3D models in Orca's editor: GLB and glTF, STL, PLY, OBJ and FBX. Orbit, zoom and pan, play animations, and check the model's real-world size on a floor grid. Read-only.",
  "license": "MIT",
  "repository": "https://github.com/momokun7/orca-3d-viewer",
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "glb",
        "title": "3D",
        "extensions": [
          ".glb"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "gltf",
        "title": "3D",
        "extensions": [
          ".gltf"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      },
      {
        "id": "stl",
        "title": "3D",
        "extensions": [
          ".stl"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "ply",
        "title": "3D",
        "extensions": [
          ".ply"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      },
      {
        "id": "obj",
        "title": "3D",
        "extensions": [
          ".obj"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      },
      {
        "id": "fbx",
        "title": "3D",
        "extensions": [
          ".fbx"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      }
    ]
  },
  "capabilities": []
}
