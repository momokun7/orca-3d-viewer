{
  "name": "orca-3d-viewer-build",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test --test-concurrency=1 test/browser/*.browser.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "lucide": "1.59.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/draco3dgltf": "1.4.3",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "draco3dgltf": "1.5.9",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "ktx-parse": "2.0.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
